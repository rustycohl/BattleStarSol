{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://groundzerogames.net/contracts/battlestar-deploy.schema.json",
  "title": "BattleStarSol tactical deployment galaxy message",
  "allOf": [
    {
      "$ref": "./galaxy-message.schema.json"
    },
    {
      "properties": {
        "type": {
          "const": "battlestar.deploy"
        },
        "payload": {
          "type": "object",
          "required": [
            "schema",
            "deploy"
          ],
          "properties": {
            "schema": {
              "const": "gzg.battlestar.deploy/1.0"
            },
            "deploy": {
              "$ref": "#/$defs/deploy"
            }
          },
          "additionalProperties": true
        }
      }
    }
  ],
  "$defs": {
    "deploy": {
      "type": "object",
      "required": [
        "type",
        "payload_contract_version",
        "generator_version",
        "rules_version",
        "sector",
        "faction",
        "seed",
        "squad",
        "objectives",
        "resources"
      ],
      "properties": {
        "type": {
          "const": "deploy"
        },
        "payload_contract_version": {
          "const": "1.0"
        },
        "generator_version": {
          "type": "integer",
          "minimum": 1
        },
        "rules_version": {
          "type": "string",
          "minLength": 1
        },
        "sector": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "faction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "seed": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "atlas_state": {
          "type": "string",
          "maxLength": 12000
        },
        "squad": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "cls": {
                "type": "string",
                "maxLength": 80
              }
            },
            "additionalProperties": true
          }
        },
        "objectives": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "maxLength": 500
          }
        },
        "map": {
          "type": "object"
        },
        "resources": {
          "type": "object",
          "properties": {
            "neural": {
              "type": "number",
              "minimum": 0
            },
            "capital": {
              "type": "number",
              "minimum": 0
            },
            "alloys": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
