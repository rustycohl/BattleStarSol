{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://groundzerogames.net/contracts/xcommand-extraction.schema.json",
  "title": "xCommand tactical extraction galaxy message",
  "allOf": [
    {
      "$ref": "./galaxy-message.schema.json"
    },
    {
      "properties": {
        "type": {
          "const": "xcommand.extraction"
        },
        "payload": {
          "type": "object",
          "required": [
            "schema",
            "extraction"
          ],
          "properties": {
            "schema": {
              "const": "gzg.xcommand.extraction/1.0"
            },
            "extraction": {
              "$ref": "#/$defs/extraction"
            }
          },
          "additionalProperties": true
        }
      }
    }
  ],
  "$defs": {
    "extraction": {
      "type": "object",
      "required": [
        "type",
        "payload_contract_version",
        "generator_version",
        "rules_version",
        "sector",
        "seed",
        "outcome",
        "survivors",
        "gains",
        "ts",
        "extraction_id"
      ],
      "properties": {
        "type": {
          "const": "extraction"
        },
        "payload_contract_version": {
          "const": "1.0"
        },
        "generator_version": {
          "type": "integer",
          "minimum": 1
        },
        "rules_version": {
          "type": "string",
          "minLength": 1
        },
        "sector": {
          "type": "string",
          "maxLength": 160
        },
        "seed": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "outcome": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "survivors": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "gains": {
          "type": "object",
          "properties": {
            "neural": {
              "type": "number",
              "minimum": 0
            },
            "capital": {
              "type": "number",
              "minimum": 0
            },
            "alloys": {
              "type": "number",
              "minimum": 0
            },
            "loot": {
              "type": "array",
              "maxItems": 10000
            }
          },
          "additionalProperties": true
        },
        "note": {
          "type": "string",
          "maxLength": 500
        },
        "replay": {
          "type": "object"
        },
        "ts": {
          "type": "number",
          "minimum": 0
        },
        "extraction_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "additionalProperties": true
    }
  }
}
