{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://battle-star.sol/contracts/deploy-1.0.schema.json",
  "title": "Battle/Star.SOL Deployment Payload",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "type",
    "payload_contract_version",
    "generator_version",
    "rules_version",
    "sector",
    "faction",
    "seed",
    "squad",
    "objectives",
    "resources"
  ],
  "properties": {
    "type": {
      "const": "deploy"
    },
    "payload_contract_version": {
      "const": "1.0"
    },
    "generator_version": {
      "type": "integer",
      "minimum": 1
    },
    "rules_version": {
      "type": "string",
      "minLength": 1
    },
    "sector": {
      "type": "string",
      "minLength": 1
    },
    "faction": {
      "type": "string",
      "minLength": 1
    },
    "seed": {
      "type": "integer",
      "minimum": 1
    },
    "squad": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "cls": {
            "type": "string"
          }
        }
      }
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "neural": {
          "type": "integer"
        },
        "capital": {
          "type": "integer"
        }
      }
    },
    "atlas_state": {},
    "map": {
      "type": "object"
    }
  }
}
